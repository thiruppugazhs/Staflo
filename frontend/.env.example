# =============================================================================
# VibeHR Frontend — Example Environment
# =============================================================================
# Copy to `.env` (gitignored) for local dev. Restart `npm run dev` after changing.
# =============================================================================

# --- Backend API ---
# Local: http://localhost:8000/api/v1
# Prod example: https://api.VibeHR.susindran.in/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# --- Supabase (public parts only, safe to expose) ---
# Get from: Supabase Dashboard → Project Settings → API
# Same as backend SUPABASE_URL
VITE_SUPABASE_URL=https://<project_ref>.supabase.co
# Public anon key — used by @supabase/supabase-js (lib/supabase.ts) for public storage URLs
VITE_SUPABASE_ANON_KEY=<anon-jwt-same-as-backend>
