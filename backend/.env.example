# =============================================================================
# Staflo Backend — Example Environment
# =============================================================================
# Copy this file to `.env` and fill real values (`.env` is gitignored).
# Supabase project ref example: epnkoxnepauxkluqewib
# =============================================================================

# --- Supabase Postgres (pooler, SQLAlchemy asyncpg) ---
# Get from: Supabase Dashboard → Database → Connection string → URI (pooled 5432)
# Keep `postgresql+asyncpg://` prefix for asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:password@db.epnkoxnepauxkluqewib.supabase.co:5432/postgres

# --- Supabase Project (Storage + Helpers) ---
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://epnkoxnepauxkluqewib.supabase.co
# Public anon key → also set as VITE_SUPABASE_ANON_KEY in frontend/.env
SUPABASE_ANON_KEY=<anon-jwt-from-supabase-api-settings>
# Secret service_role → backend only for storage bucket uploads (never expose to frontend)
SUPABASE_SERVICE_KEY=<service_role-jwt-from-supabase-api-settings>

# --- JWT Auth (FastAPI python-jose) ---
# Generate: openssl rand -hex 32  (32+ chars)
SECRET_KEY=change-this-to-a-random-32-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated CORS origins (must be lowercase, exact match incl. scheme; no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://staflo.io
# Base URL of the frontend — used in verification / invite email links (no trailing slash)
FRONTEND_URL=https://staflo.io

# --- SMTP Email (Brevo Relay) ---
# Get from: Brevo Dashboard → Transactional → SMTP & Senders & Domains
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<brevo-smtp-login-e.g.-a2301b001@smtp-brevo.com>
# Brevo SMTP key placeholder (regenerate if 535 auth fails)
SMTP_PASSWORD=<brevo-smtp-key-placeholder>
# Must be verified sender domain in Brevo (SPF/DKIM)
SMTP_FROM_EMAIL=noreply@staflo.io
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Feature Flags ---
# true = login 403 until email verified via /auth/verify-email; false = soft banner only
REQUIRE_EMAIL_VERIFICATION=false

# --- HR Chatbot: OpenAI (or any OpenAI-compatible provider) ---
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=<openai-secret-key-sk-...>
# Base URL — change to a compatible endpoint (e.g. https://api.groq.com/openai/v1, Azure/OpenRouter) or leave default
OPENAI_BASE_URL=https://api.openai.com/v1
# Chat model to use (e.g. gpt-4o-mini, gpt-4o, llama-3.1-70b-versatile on Groq)
OPENAI_MODEL=gpt-4o-mini

# --- Google Calendar + Meet (real Meet links for meetings) ---
# Setup: Google Cloud Console → new project → enable "Google Calendar API" →
# Credentials → Service Account → Keys → Add key → JSON (download the file).
# Option A (recommended): path to the downloaded service-account JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON=
# Option B: paste the full JSON key content on one line instead of a file path
GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT=
# Option C (personal Gmail): OAuth client id/secret + refresh token granted the
# https://www.googleapis.com/auth/calendar scope
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Google Workspace only: domain-wide delegation subject so the service account
# acts as this real user (Admin Console → Security → API controls → Domain-wide delegation)
GOOGLE_IMPERSONATE_EMAIL=
# Calendar events are created here (default: the account's primary calendar)
GOOGLE_CALENDAR_ID=primary
